# Alert (Gotify) + eject when a damaged disc hangs the drive before udev ever reports it
# (dvd-backup.sh --watch follows the kernel log for sr* timeouts / device offline).
[Unit]
Description=Watch optical drives for unreadable discs
Documentation=https://git.karubits.com/Karubits/dvd-backup

[Service]
EnvironmentFile=/etc/dvd-backup/env
ExecStart=/usr/local/sbin/dvd-backup.sh --watch
Restart=always
RestartSec=10
RuntimeDirectory=dvd-backup-watch
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
