# Finish work dirs a failed dvd-backup@ run left behind (no disc needed): convert →
# upload → album → cleanup. Run after fixing the cause: systemctl start dvd-backup-resume
[Unit]
Description=Resume pending DVD backups (no disc needed)
Documentation=https://github.com/Karubits/dvd-backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/dvd-backup/env
ExecStart=/usr/local/sbin/dvd-backup.sh --resume
# Root is needed to mount the disc (read-only, private to this unit).
# Writable: StateDirectory (/var/lib/dvd-backup, incl. the default WORK_ROOT). For a
# WORK_ROOT elsewhere add a drop-in (systemctl edit <unit>):
#   [Service]
#   ReadWritePaths=/your/work/root
RuntimeDirectory=dvd-backup
StateDirectory=dvd-backup
PrivateMounts=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=6h
