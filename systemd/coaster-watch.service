# Alert (NOTIFY backends) + eject when a damaged disc hangs the drive before udev ever reports it
# (coaster --watch follows the kernel log for sr* timeouts / device offline).
[Unit]
Description=Watch optical drives for unreadable discs
Documentation=https://github.com/Karubits/coaster

[Service]
EnvironmentFile=/etc/coaster/env
ExecStart=/usr/local/sbin/coaster --watch
Restart=always
RestartSec=10
RuntimeDirectory=coaster-watch
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
# Hardening that doesn't get in the way of mount/eject/ffmpeg/curl (systemd-analyze security).
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
