# /etc/coaster/env — mode 0600 root. Read by coaster@.service.
# setup.sh asks for the main settings; re-run `sudo ./setup.sh --configure` to change them.

# Where backups go: immich, path, or both ("immich path")
DESTINATION=immich

# Immich server and API key (permissions: asset.upload, album.read, album.create, albumAsset.create)
IMMICH_URL=https://immich.example.com
IMMICH_API_KEY=changeme
IMMICH_ALBUM="DVD Uploads"          # DVD-Video titles
IMMICH_PHOTO_ALBUM="Photo Discs"    # photos/videos from data CDs/DVDs

# DESTINATION=path: each disc goes to SAVE_DIR/<date> <label>/ (videos as MP4, photos with the
# disc's folder structure). SAVE_DIR must exist (a missing one is treated as "not mounted").
#SAVE_DIR=/srv/media/discs
#SAVE_OWNER=youruser:yourgroup     # chown saved files (the service runs as root)

# Notifications on success and failure: auto (every backend configured below), none, or a
# list such as "ntfy" or "gotify,pushover"
NOTIFY=auto

# Gotify — app token from Gotify → Apps
#GOTIFY_URL=https://gotify.example.com
#GOTIFY_TOKEN=

# ntfy — topic on ntfy.sh or your own server; NTFY_TOKEN for protected topics (tk_…)
#NTFY_URL=https://ntfy.sh
#NTFY_TOPIC=
#NTFY_TOKEN=

# Pushover — application API token + your user key
#PUSHOVER_TOKEN=
#PUSHOVER_USER=

# Webhook — POSTs JSON. WEBHOOK_FORMAT: json ({title,message,priority,host}), slack (Slack,
# Mattermost, Rocket.Chat incoming webhooks) or discord. WEBHOOK_HEADER: one extra header.
#WEBHOOK_URL=
#WEBHOOK_FORMAT=json
#WEBHOOK_HEADER="Authorization: Bearer changeme"

# Scratch space for rips/encodes (deleted after a successful backup; kept on failure for retry).
# Needs room for one disc (up to ~9 GB for a dual-layer DVD). setup.sh allows a path outside
# /var/lib/coaster in the units (ProtectSystem=strict).
#WORK_ROOT=/var/lib/coaster/work

# Titles shorter than this are treated as menus/intros and skipped
MIN_TITLE_SECONDS=20

# Encoder: x264 (CPU, best quality/size) or vaapi (Intel/AMD iGPU)
ENCODER=x264
X264_PRESET=slow
X264_CRF=18
#VAAPI_QP=20
#VAAPI_DEVICE=/dev/dri/renderD128
AUDIO_BITRATE=192k
