# Data disc (DVD-Video, or a photo/data CD/DVD) inserted → start the backup unit.
# TRACK_COUNT_DATA (from cdrom_id) excludes audio CDs. A media change is a "change"
# event (not "add"), so SYSTEMD_WANTS wouldn't fire; systemctl --no-block returns
# immediately, and a duplicate event is a no-op while the instance is running.
ACTION=="change", SUBSYSTEM=="block", KERNEL=="sr[0-9]*", ENV{ID_CDROM_MEDIA}=="1", ENV{ID_CDROM_MEDIA_TRACK_COUNT_DATA}=="?*", RUN+="/usr/bin/systemctl --no-block start coaster@%k.service"
